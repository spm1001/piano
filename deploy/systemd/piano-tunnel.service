[Unit]
Description=piano — cloudflared tunnel for ping.planetmodha.com
After=network-online.target piano-ping.service
Wants=network-online.target
Requires=piano-ping.service
# Restart=always + NO start limit — deliberate, and different from the other daemons
# (iw-rogopo, 2026-07-26). This unit's crash-loops ARE network unavailability, chiefly
# the post-boot window: on 2026-07-26 every boot began with a loop (30 restarts at a 6s
# cycle, 14:36:27–14:39:21, on the 14:36 boot — network-online.target is reached before
# the network is actually usable) which self-healed the moment the network came up and
# ran clean for hours after. ANY start limit would trip ~a minute into a slow boot and
# leave the public endpoint permanently dead after every reboot — and the OnFailure
# email can't send while the network is down anyway (msmtp has no queue). Self-healing
# wins; audibility for this endpoint belongs to an external uptime check, not a start
# limit. The loop is gentle (~10 starts/min, cloudflared exits in ~1s) so unlimited
# retry costs nothing.
StartLimitIntervalSec=0

[Service]
Type=simple
# cloudflared installed as x86 .deb from GitHub releases (Cloudflare's apt repo key URL
# 404'd at install time, 2026-07-07). NOT covered by unattended-upgrades — the update
# story is parked in iw-solema (maintenance layer). Credentials: ~/.cloudflared/
# {config.yml, <tunnel-uuid>.json, cert.pem} — copied from hezza; DNS points at the
# tunnel UUID, so the same credentials serve from any machine, no DNS change on a move.
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate --config %h/.cloudflared/config.yml run
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
